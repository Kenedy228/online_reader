# Default-deny build context: only Maven/Java/frontend build inputs are sent.
# After admitting a parent directory, deny descendants again before selecting inputs.
**
!pom.xml
!mvnw
!.mvn/
.mvn/**
!.mvn/wrapper/
.mvn/wrapper/**
!.mvn/wrapper/maven-wrapper.properties
!main/
main/**
!main/java/
!main/java/**
!main/resources/
main/resources/**
!main/resources/application*.properties
!main/resources/META-INF/
main/resources/META-INF/**
!main/resources/META-INF/spring.factories
!main/resources/db/
main/resources/db/**
!main/resources/db/migration/
main/resources/db/migration/**
!main/resources/db/migration/V*.sql
!main/resources/templates/
!main/resources/templates/**
!main/resources/static/
main/resources/static/**
!main/resources/static/styles/
!main/resources/static/styles/**
!main/resources/static/assets/
!main/resources/static/assets/**
!main/frontend/
main/frontend/**
!main/frontend/package.json
!main/frontend/package-lock.json
!main/frontend/tsconfig.json
!main/frontend/webpack.config.js
!main/frontend/src/
!main/frontend/src/**
!test/
test/**
!test/java/
!test/java/**
!test/resources/
test/resources/**
!test/resources/application-test.properties
# Secrets remain excluded even if placed in an allowed source directory.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.dump
**/node_modules/
**/target/
