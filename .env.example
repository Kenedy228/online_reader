# Spring Boot does not load this file automatically; see docs/security.md.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/online_reader
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Mailpit only: localhost/127.0.0.1/::1 or Docker service mailpit; no SMTP credentials.
SPRING_MAIL_HOST=127.0.0.1
SPRING_MAIL_PORT=1025
# Production requires an absolute path; storage is not implemented yet (#22).
ONLINE_READER_STORAGE_ROOT=./var/books
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=11MB
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
HTTP_CONNECTION_TIMEOUT=10s
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=1000
MAIL_CONNECTION_TIMEOUT_MS=3000
MAIL_READ_TIMEOUT_MS=3000
MAIL_WRITE_TIMEOUT_MS=3000
